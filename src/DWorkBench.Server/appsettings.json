{
  "Database": { "Provider": "Postgres" },
  "ConnectionStrings": { "DWorkBench": "" },
  "Storage": { "Root": "" },
  "Protection": { "CertificateThumbprint": "", "CertificatePath": "", "CertificatePassword": "" },
  "Bootstrap": { "Token": "" },
  "Limits": {
    "SubscribersPerUser": 4, "SubscribersPerHost": 128, "SubscribersGlobal": 512,
    "ReadersPerHost": 8, "ReadersGlobal": 32, "ReaderIdleSeconds": 3,
    "SubscriberBufferFrames": 64, "SubscriberBufferCharacters": 262144,
    "ReplayLines": 200, "ReplayCharacters": 131072, "BatchMilliseconds": 40,
    "DownloadsGlobal": 2
  },
  "AllowedHosts": "*",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } }
}
